{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(agent-pay|free-sample|tip-manifest|service-catalog|backer-wall|prospect-pack-latest)\\.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/x402",
      "destination": "/.well-known/x402.json"
    }
  ],
  "routes": [
    {
      "src": "/deliverables/(briefing-latest|briefing-cycle-[0-9]+)\\.json",
      "status": 402,
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Content-Type": "application/json",
        "PAYMENT-REQUIRED": ""
      },
      "continue": false
    },
    {
      "src": "/deliverables/(micro-tool-latest|micro-tool-cycle-[0-9]+)\\.json",
      "status": 402,
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Content-Type": "application/json",
        "PAYMENT-REQUIRED": ""
      },
      "continue": false
    },
    {
      "handle": "filesystem"
    }
  ]
}